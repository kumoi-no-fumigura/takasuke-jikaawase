 ],
 "poems": [
  {
   "seq": "1",
   "text": "春の日の名にあらはるゝ山よりや空も長閑に霞そむらん",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "もろこしも同しみ空のかすみてや吉野の里に春はきぬらむ",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "あつさ弓春しきぬれは足曳の山のあらしも聲よはる也",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "あなし河氷つれなし卷向の檜原やいまた曇らさるらん",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "試しとや千世のふる木のこの本に老そふ松をけふはひく覽",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "春の野に殘る小松のおはかれはひかても千世の陰そまたるゝ",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "鶯の春にきなけは難波津にうらはの浪もさくや此花",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "谷深きふるす出ても鶯のなを光なき宿に啼也",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "常盤木の陰にかくるゝ山里はまたふるとしの春の白雪",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "春も猶とはぬ人めはかれはてゝ垣ねの雪そ友を待ける",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "宮古まて飛火の野守つけねとも若菜つみにとけふそ出ける",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "朝またきまたうらわかき草の原おもへは秋の露もほとなし",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "しほかまや昔の烟あともなし霞はすゑに立かはれとも",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "いにしへの霞の袖や立かへりみかきか原の猶しほるらん",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "暮かゝる霞のうちの山のはを人にしられて出る月かけ",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "此頃はかすみの袖やむすふ手の雫にゝこる山の井の水",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "あさ日山うつろふ影もかすみつゝ遠さかり行宇治の川浪",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "湊入の月のみ舟もさはりおほみ背間の波にかすむ比哉",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "天原いすまぬ空の雨にたに人やはみえし峯のかけはし",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "幾かすみめにみぬ里をしる物は風のつてなる春の梅かえ",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "誰をかも知人にして梅のはなかりねの野へに匂ひそめけん",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "吹風に木の下はらふ玉柳いとはぬ春の朝きよめかな",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "小山田のきしの柳も打はへて引しめ繩にかけそあらそふ",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "定めなき花の都のちきり哉行ては歸る春の膓かね",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "輸風にあひみん〓とはいのちとも契らてかへる春のかりかね",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "時わかぬ川瀨の波の花にさへわかれて歸る春の膓かね",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "つれもなきかたへの櫻待わひて春やをそきと花や咲らん",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "花とみて山ちは末になりぬれとまた僞の岑の白雲",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "よし野山松も二たひ埋もれぬ花咲つもる雪の朝けに",
   "kana": "",
   "speaker": "",
   "page": 559,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "山さくらおられぬ岑もなかりけり雲の衣の花染のそて",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "こゆるきの磯山さくら咲しより沖津なみまにとまる舟人",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "山櫻有明の月にうつろはゝつれなき色にちらすもあらなん",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "春風のいかに吹はか山櫻散もちらぬも盛なるらん",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "春の嵐吹にけらしなかつらきや高まの櫻雪と降まで",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "今朝まては木〓に見えつる花の色を雪に吹なす庭の春風",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "いかにせんやよひの末の山風にさらぬわかれのみよしのゝ花",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "しるしらすうきて思ひのみえつらん花散山のむら雲の空",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "しらさりきやとの藤波影みえてせき入し水を春の物とは",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "うつり行やよひの末に咲そめてちらぬもつらき山吹の花",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "あけたては花の色かもすて衣うすき契やかたみ成らん",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "夕月夜うつろひまかふかひもなし袖にかけ見ぬ庭の卯花",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "待えてもうはの空なるあま雲のよそにのみ鳴時鳥哉",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "なけしはし涙をからは郭公うき身ひとつの袖を尋て",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "里はあれて聞人がはる時鳥同し昔をいかゝさたむる",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "故里と思ひなすてそほとゝきすなれも昔の聲はかはらし",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "蜑小船はつせの山の名もしるし檜原かみおの五月雨のそち",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "五月雨のたえまも見えす暮る日は曇るにつけてとふ人もなし",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "岩まより分れておつる瀧津せもひとつに成ぬ五月雨の頃",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "五月雨に岩きりとをし行とたにあまりて見えぬ水の白波",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "足曳の山田もる庵はあれにしを又いつのまに早苗とるらん",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "明かたは木々の雫やたまるらんは山のともし影そしほるゝ",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "蓮葉の花のかゝみに成比はうき世の外の影もみゆらん",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "氷室山木のまもりくる夏の日の氷によはる影そ寒けき",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "世にすまぬみ山かくれの庵まて板井の水をはらふ比哉",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "宮古にもあかてやむすふ泉河てる日に雲の衣かせ山",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "蚊遣火をふせやの床に立をきてすゝみに出る庭の松風",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "島ひゝくいらこか崎の波まにもこたへぬ玉は螢なりけり",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "秋ちかき袖師の浦に波わけてかけもつゝます飛螢哉",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "暮かゝる草の葉山を限にて秋のみちかき武藏のゝ原",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "吹風もけふ立なれて初瀨女かゆふはなかくる秋の河波",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "秋はけさたつをた卷のつかのまも今はた露のひまやなからん",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "今朝みれは露のみしけき淺茅生に風も吹あへす秋はきにけり",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "初秋の雲行風はいたつらにくるれは出ぬやまのはの月",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "吹はらふまかきの荻の夕露を袂にのこす秋の初風",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "夕暮は月まつとても物そ思ふ雲のはたての秋の山の端",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "天川あふせもしるしわかうへは露置そめてさ夜更にけり",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "たよりある關の〓水にやとりても年にまれなる星合の空",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "夕日さす峯のこすゑはあらはれて麓の霧に逢人なそき",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "ゆふ日さす遠山本の里みえて薄吹しく野への秋風",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "末てらす三笠の山にすむ月のかゝみをかけて神は知らん",
   "kana": "",
   "speaker": "",
   "page": 560,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "空晴て行ともみえぬ秋風を光になしてすめる月かな",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "久方の月より外の影もなし露の下なる小のゝ篠原",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "色まさる月のかつらや吹風の散もおしまぬ秋の紅葉は",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "里遠き月みんとても契をかぬ草の枕に松風そ吹",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "山賤のそのふをかけてかこつとも月はいやしき色なかりけり",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "すみはてゝ遠里小野を行月の猶めにかゝる波の上かな",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "漕わたるあし分小船おなし江に〓そそもなく月そ更行",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "むかし思ふ人たにあらし更科やなは捨山に月はすむとも",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "またれつる關に水こふほとなれや大宮人に望月の駒",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "久かたの天の河原にたゝぬ日はまれなる比の秋の夕霧",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "吹風はまのゝ入江の花すゝきなひくや浪のかへ〓成らむ",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "女郞花露おもけなる花の枝に心もしらぬ野への秋風",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "玉鉾のゆきゝの野への旅人に匂ひをきする藤袴かな",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "末たはに後のしの原なひけとも猶聲しるき荻の上風",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "しら鳥のとは山あらし吹なへに尾花か末は浪のまもなし",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "はつかりの音に立そむる夕へより物思ふやとの秋も悲しき",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "かよひくる秋の枕のきり〓〓す籬の露や夜寒成らん",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "秋山のふもとの杜に啼鹿は神たにうけぬ物やかなしき",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "泊瀨山おなし尾上に立しかも更る枕は聲そ近つく",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "野わけより軒端のひまに中絕てあはすは何をさゝかにの糸",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "我宿の軒はの木の葉そめしよりたつ日はきかし四方の山風",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "晴くもり幾度空にしくれてかしのたの杜をそめつくすらん",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "秋の日もなからの山の紅葉〓は大つの里のかさし成けり",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "もみち葉のうきねの浪にかけみえて夕日もとまる秋の山本",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "うきねする浦半に近き山なれと幾しはまては木の葉そむらん",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "衣うつよそのね覺の秋風も月みよとてや袖にふくらん",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "大かたのよを秋はつるしるへしてよのまやすます打衣哉",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "かさゝきもわたさぬ橋のあたりまてほしか川への白菊の花",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "ね覺して月みしよりも行秋のわかれそ干ゝに物は悲しき",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "をのつから殘る梢の秋の色もけさは淋しき神無月哉",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "木からしのかはれる色はなけれとも神無月とや吹まさるらん",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "立田山木の葉の後にあらはれて松こそ冬のはしめ成けれ",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "よそになる宮古の空にめくりあはゝ時雨る山も袖やほさまし",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "霜枯の籬の菊の花かたみめならふ色もみえぬ比哉",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "みつくきの岡のやかたは人はなしいとはぬ霜の幾夜をくらん",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "山風につもる木の葉や散ぬらん庭もまはらに降時雨かな",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "おしみこし秋はとまらて網代木にまたぬ木のはのょらぬ日もなき",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "駒とめてえそ水かはぬさゝのくま日のくま河に氷とちつゝ",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "おきつなみ波吹上の濵千鳥玉かあらぬか霰よす也",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "立田川木の葉の色をせきとめて氷そ秋のかたみ成ける",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "さす棹の雫にゝこる大井河となせの瀧はしからみもなし",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "炭かまの烟の下もいたつらに淋しさたへぬ小野の山里",
   "kana": "",
   "speaker": "",
   "page": 561,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "限りあれは鳥立すくなく成にけりたゆむ日もなき御狩野の原",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "山河に數かきとめぬをし鳥の跡つけそむるうす氷がな",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "山河のこほる夜〓とにすみかへて床もさだめぬをしのひとりね",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "冬かれの蘆まの水にゐる鳥の氷そ今は床になしける",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "石はしる瀧津岩なみ行末をあらそひかねて氷る冬哉",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "住よしの岸による波よる〓〓は鳴や千鳥の人めよくらん",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "浪よする岸に生てふ川竹の夜半もあらはに立千鳥哉",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "藻かり船よるへもしらすあるかひの波にもたつの聲さはく也",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "降雪をしきつの浦の友千鳥波の上にも跡はつけゝり",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "人とはぬ軒はの松にふる雪の道を殘してつもる日もかな",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "奥山の木のはのうへに降雪を落くる水のすゑにみる哉",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "枝かはすたえまもみえす常磐山ちらぬ木の葉とふれる白雪",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "うつもれて終にもみちぬ松とたに忘る計にふれる白雪",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "よし野山今こん年の花よりもまたも降しけ峯の白雪",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "かきくもり淺間の煙うつめとも雪をも人のみやはとかめぬ",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "さえわたる有明の月の山のはに入影みえて積るしら雪",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "雪折の音たに今はたえにけりうつもれはつる峯の松はら",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "またれつゝ恨むるまてはなけれとも知らぬもつらき心んけり",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "逢事はゝつをのかゝみ影たえぬ遠山鳥の音にやたつらん",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "山吹の花色ころもきしかたはいはて過しもあらはれにけり",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "あひみてしいもせの山の玉かつらくるゝ夜〓に戀つゝそふる",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "祈つゝけふは幾日もこもり江の初瀨の檜原さてもつれなし",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "物思ふ身こそあさまの夕けふり都なからにみやはとかめぬ",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "なひきこし煙をよそに吹なして涙もよふす袖の浦風",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "今も又かたみにけたぬ煙にも思ひや富士のれにあまるらん",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "まてしはし烟の下になからへてむろの八島も人はすみけり",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "したにもえうへは霞てかはらやの人たにしらぬ身の思ひ哉",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "吹風に鳴やうつらの床あれでさそひとりねの秋は悲しき",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "草枕あたのかりねの枕にもつらき心や行めくるらん",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "夢にたに音信たゆる夜な〓〓は袖の泪や床の山守",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "いかにせん逢にしかへぬ月日へて徒にのみ身はよはりつゝ",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "雲はらふ風そたよりのしるへとて思ふかたより月を待かな",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "をのつから思ひ出てはなかむともくもらぬ袖に月や待らん",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "歸るさのかたみとたにもたのまれす我身にかへぬ有明の月",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "俤のかたみとたにもやすらはておなしわかれの有明の月",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "河島のまつの心はしられとも難面みえて年は經にけり",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "風吹はとはに浪こす石見かたかたふく月もぬるゝ顔なる",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "枯はつる人の契の淺茅原しのにしめゆふ軒の立花",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "梓弓いく田の川に身を捨て名をのみおしむあとそはかなき",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "戀をのみしなのゝま弓徒に心計はひくかひもなし",
   "kana": "",
   "speaker": "",
   "page": 562,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "人こゝろよのうきよりも憂度の袖にそひろふ瀧の白玉",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "暮ぬとて待し夜比の白露はわかるゝ袖の淵と成ける",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "うへにみぬ思ひの色の下染はたへす忍ふの山の口なし",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "うくつらく人の心を秋の田のいねてふ〓とはかりになしてよ",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "かけて思ふ心のしめはくちねとも神たにうけぬ年はへにけり",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "我身とて山の岩木にあらはこそ憂もつらきもさてはすくさめ",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "しらま弓はるかにみゆる波まより春日にまかふあけのそほ舟",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "あつさゆみ幾山越てはる〓〓と暮行峯やとまり成らん",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "旅人の苔のさむしろ敷しのひしらぬ別に露そこほるゝ",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "とはれれはゝれぬ雲井にわふとたに都に誰か思ひ知へき",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "吹風に烟や遠くなひくらん里なき風もゝしほやきけり",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "おほつかないつれの山にかゝるらん波の上なる空の浮雲",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "かきりあれはかすまぬ浦の浪ま〓り心ときゆる蜑の釣舟",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "見渡せはみおの浦半の夕なきに猶波かくる興津島山",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "人しれす我身ひとつの山里は世のうき〓とも聞えさりけり",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "踏わくる道たに深き苔の下に誰うつもれて朽果にけり",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "山里は明行空もあけやらて雲に殘れる窓の灯",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "うきたひの心は深き山もあらし是より奥に住かはるとも",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "世中の人にしらるゝ山なれは吉野の奥も猶やいとはん",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "和哥の浦や過にし御代の變らずは庭のもくすも顯れなまし",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "世の中に思ひけてとも和哥の浦や身を慰むるあまのもしほ火",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "身をすつる誰あらましも難面てさそふ水あらは花そ流るゝ",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "175",
   "text": "かれやあらぬ藤の末葉のかひもなくまた紫の衣ならねは",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "176",
   "text": "慰さめし秋のねさめのあらましも思ひそよはる年のへぬれは",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "177",
   "text": "もしほひにあらぬ烟になりはてゝ見しは昔のわかのうら人",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "178",
   "text": "をのつから人にひかるゝ時やあると眞弓の岡に宿やからまし",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "179",
   "text": "くらゐ山ふもとはかりの道をたになを分かたくかゝる白雲",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "180",
   "text": "世中に猶あり明のうき身をやつれなきものゝ月はみるらん",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "181",
   "text": "風吹はさやの中山なか空にかゝるかたなくまよふ白雲",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "182",
   "text": "花もまた春にをくれて物や思ふことし卯月の谷隱つゝ",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "183",
   "text": "藤衣かはる袂の黑染にやかてうき世をいとひ果はや",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "184",
   "text": "知しらすうき世を渡る人はみななからの橋のためしなりけり",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "185",
   "text": "此世にはよしことゝはし角田川すみえぬかたの鳥の名もうし",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "186",
   "text": "大井川おりゐる鷺の立跡を淺瀨としりてわたるから人",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "187",
   "text": "はかなしやさめても夢の世中をうちふす程と思ひけるかな",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "188",
   "text": "なき人の此世にかへる俤の哀ふけゆく秋のともし火",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "189",
   "text": "小倉山峯のもみちの散しより梢の風は松に吹也",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "190",
   "text": "竹の葉に衣をかけしいにしへの人の心のなき世成けり",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "191",
   "text": "わかの浦や行末かけて出る日に聲ものとけき春のあしたつ",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "192",
   "text": "人しれぬ山の草木も春雨に神の惠を空に知けり",
   "kana": "",
   "speaker": "",
   "page": 563,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "193",
   "text": "君か代を松につけてそ春日山藤の末葉も花は咲へき",
   "kana": "",
   "speaker": "",
   "page": 564,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "194",
   "text": "侍〓ももかゝらん物は郭公今そ北野の空に鳴なる",
   "kana": "",
   "speaker": "",
   "page": 564,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "195",
   "text": "行すみの千世のあまいもしら菊の秋くれかゝる色そ久しき",
   "kana": "",
   "speaker": "",
   "page": 564,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "196",
   "text": "神のます春日山ちの四の海の波風あらき時のまもなし",
   "kana": "",
   "speaker": "",
   "page": 564,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
